# Copy to .env (KEY=VALUE lines only — docker compose is strict).

# Required
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Postgres: the compose db locally; Supabase's Transaction pooler URI in production
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/churn

# Optional: LangSmith tracing + live eval experiments
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=churn

# Serving
EMBEDDER=                       # "fastembed" on Vercel (ONNX, no torch)
MODEL_BUNDLE_PATH=models/champion.joblib
ANALYSIS_LIMIT_PER_HOUR=20      # per-IP limit on war-room runs (0 = off)
CORS_ORIGINS=
